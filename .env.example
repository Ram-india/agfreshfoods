# Copy to `.env` and fill in as needed. All Vite env vars must start with VITE_.

# Optional. Where contact/dealer forms POST their JSON payload.
# Leave blank and forms hand off to WhatsApp with a prefilled message instead.
# Works with Formspree, Web3Forms, a Netlify/Vercel function, or your own
# Node/Express route. Expected: POST JSON, respond 2xx on success.
VITE_FORM_ENDPOINT=

# Used by `npm run sitemap` to build absolute URLs.
SITE_URL=https://www.agfreshfoods.com
